---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceList from '../components/ExperienceList.astro';
import PostList from '../components/PostList.astro';
import { site } from '../data/site';
import { getProjects, getExperience, getPosts } from '../data/queries';
const projects = (await getProjects()).filter((p) => p.data.featured);
const experience = (await getExperience()).slice(0, 3);
const posts = (await getPosts()).slice(0, 3);
---
<Base>
  <section class="hero">
    <div class="kicker mono">{site.tagline}</div>
    <h1>Hi, I'm Shubham. I build backend systems and, lately, <em>AI tools</em>.</h1>
    <p>10+ years building distributed systems and cloud infrastructure at Amazon, Oracle and Harness. Now focused on AI engineering: Claude, MCP and agentic workflows.</p>
    <div class="links mono">
      <a href="/projects">See projects →</a>
      {site.social.map((s) => <a href={s.url}>{s.label} ↗</a>)}
      <a href={`mailto:${site.email}`}>Email</a>
    </div>
  </section>

  <section class="block">
    <div class="sec-head"><h2>Selected projects</h2><a class="mono" href="/projects">All →</a></div>
    <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
  </section>

  <section class="block">
    <div class="sec-head"><h2>Experience</h2><a class="mono" href="/experience">Full →</a></div>
    <ExperienceList items={experience} showHighlights={false} />
  </section>

  <section class="block">
    <div class="sec-head"><h2>Writing</h2><a class="mono" href="/writing">All →</a></div>
    <PostList posts={posts} />
  </section>
</Base>
