---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../data/queries';
const projects = await getProjects();
---
<Base title="Projects" description="Things I've built.">
  <h1 class="page">Projects</h1>
  <p class="lede">Personal and professional work. Each one has a write-up, links and screenshots.</p>
  <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
</Base>
